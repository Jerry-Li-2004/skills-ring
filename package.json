{
  "name": "skills-ring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "npm run build:server && node --env-file-if-exists=.env.production --env-file-if-exists=.env.local server/server.mjs",
    "build": "tsc -b && node scripts/build-server.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build:server && node --env-file-if-exists=.env.production --env-file-if-exists=.env.local server/server.mjs",
    "test": "vitest run src",
    "test:auth": "node --test server/app.test.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test:production": "npm run build:server && node --test server/production.test.mjs server/registration.test.mjs server/starter-store.test.mjs",
    "test:python": "cd raw-database && python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
