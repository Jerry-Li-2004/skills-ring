# Browser-safe project configuration (also read by the local Node server).
VITE_SUPABASE_URL=https://mwyictnozocjicjeacqk.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Server-only. Never prefix a secret with VITE_.
SUPABASE_URL=https://mwyictnozocjicjeacqk.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
# SUPABASE_SERVICE_ROLE_KEY is accepted for legacy installations.
